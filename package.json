{
  "name": "taiwan-driving-test",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "extract": "node extract-questions.js && python3 extract_images.py && python3 map_images_to_questions.py",
    "extract:en": "node extract-questions.js",
    "extract:zh": "node extract-zh.js",
    "extract:all": "npm run extract:en && npm run extract:zh && node extract-all.js",
    "test": "vitest --run",
    "dev": "vite",
    "build": "vite build",
    "build:app": "CAPACITOR=1 vite build && npm run check:offline && cap sync",
    "check:offline": "node scripts/check-offline.js",
    "app:ios": "npm run build:app && cap open ios",
    "app:android": "npm run build:app && cap open android",
    "app:icons": "capacitor-assets generate --iconBackgroundColor '#ffffff' --splashBackgroundColor '#ffffff'"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "canvas": "^3.2.1",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^5.4.624"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "fast-check": "^4.6.0",
    "happy-dom": "^20.8.4",
    "jsdom": "^27.0.1",
    "vite": "^5.0.0",
    "vitest": "^4.1.0"
  }
}
